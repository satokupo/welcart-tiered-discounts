# Generated local-only values are written by scripts/init-local-env.sh.
# Do not commit docker/local.env or replace these placeholders with real credentials.
LOCAL_UID=__LOCAL_UID__
LOCAL_GID=__LOCAL_GID__

RECOMMENDED_DB_NAME=wordpress
RECOMMENDED_DB_USER=wordpress
RECOMMENDED_DB_PASSWORD=__RECOMMENDED_DB_PASSWORD__
RECOMMENDED_DB_ROOT_PASSWORD=__RECOMMENDED_DB_ROOT_PASSWORD__
RECOMMENDED_WP_ADMIN_USER=admin
RECOMMENDED_WP_ADMIN_PASSWORD=__RECOMMENDED_WP_ADMIN_PASSWORD__
RECOMMENDED_WP_ADMIN_EMAIL=admin@example.test
RECOMMENDED_WP_URL=http://127.0.0.1:8080

LATEST_DB_NAME=wordpress
LATEST_DB_USER=wordpress
