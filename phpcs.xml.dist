<?xml version="1.0"?>
<ruleset name="Welcart Tiered Discounts">
	<description>WordPress Coding Standards for the plugin source.</description>

	<rule ref="WordPress" />
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="wel_manage_order" />
			</property>
		</properties>
	</rule>

	<file>plugin</file>

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/runtime/</exclude-pattern>
</ruleset>
