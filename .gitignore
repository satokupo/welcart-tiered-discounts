# グローバルで管理していないものだけ記載する
# （グローバル gitignore: ~/.config/git/ignore）

# .claude/plans/ はグローバルで直下ファイルのみ無視しているため、
# サブディレクトリ（yyyy/mm/）を追跡するために明示的にアンイグノア
!.claude/plans/
!.claude/plans/*/
!.claude/plans/*/**

# 視覚資料（Git管理外）
docs/visdoc/items/

# ローカル認証情報（サンプルは追跡する）
/docker/local.env

# Composer / PHPUnit / PHPCS のプロジェクトローカル生成物
/vendor/
/.phpunit.cache/
/.phpunit.result.cache
/.phpcs-cache/
/coverage/

# WordPress / Welcart / Docker のランタイム生成物
/runtime/
/docker/runtime/
/docker/volumes/
/docker/logs/
/wordpress/
/welcart/
/db/
/mysql/
/wp-content/
/docker/wordpress/wp-content/uploads/
/docker/wordpress/wp-content/plugins/
/docker/wordpress/wp-content/themes/
/*.sql
/.wp-cli/cache/
/wp-content/uploads/
/wp-content/cache/
/uploads/
/debug.log
/*.log
/**/*.log

# ローカルOSのメタデータ
.DS_Store

# 提出レポートで配信する動画2本はGit管理する
!docs/report/public/media/buy3.mp4
!docs/report/public/media/edit2.mp4

# Wranglerのローカルキャッシュ
/.wrangler/
